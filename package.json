{
  "name": "club-planner",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "corpus:generate": "python tools/generate_recognition_corpus.py",
    "corpus:validate": "node tools/validate-recognition-corpus.mjs",
    "recognition:benchmark": "tsx tools/run-recognition-benchmark.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm corpus:validate && pnpm recognition:benchmark && vite build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
